@model IEnumerable<dataAccess.Models.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="text-primary fw-bold">
            Employee Management
        </h2>

        <a asp-action="AddEmployee"
           class="btn btn-success">
            + Add New Employee
        </a>

    </div>

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Employee Directory</h5>
        </div>

        <div class="card-body">

            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th class="text-center">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.id</td>

                            <td>
                                <strong>@item.name</strong>
                            </td>

                            <td>@item.email</td>

                            <td class="text-center">

                                <a asp-action="EditEmployee"
                                   asp-route-id="@item.id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="EmployeeLogin"
                                   asp-route-id="@item.id"
                                   class="btn btn-info btn-sm text-white">
                                    Details
                                </a>

                                <a asp-action="DeleteEmployee"
                                   asp-route-id="@item.id"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="mt-3">

        <a asp-action="Homepage"
           class="btn btn-secondary">
            Back to Home
        </a>

    </div>

</div>