@model dataAccess.Models.Employee

@{
    ViewData["Title"] = "Employee Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-success text-white text-center py-3">
                    <h3>Employee Login</h3>
                    <h2>Welcome to your login </h2>
                </div>

                <div class="card-body p-4">

                    <form asp-action="EmployeeLogin" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="email" class="form-label fw-bold">
                                Email Address
                            </label>
                            <input asp-for="email"
                                   class="form-control"
                                   placeholder="Enter your email" />
                            <span asp-validation-for="email" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="password" class="form-label fw-bold">
                                Password
                            </label>
                            <input asp-for="password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Enter your password" />
                            <span asp-validation-for="password" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                Login
                            </button>
                        </div>

                    </form>

                </div>

                <div class="card-footer text-center bg-light">

                    Don't have an account?

                    <a asp-action="AddEmployee"
                       class="text-decoration-none fw-bold">
                        Register Here
                    </a>

                    <br /><br />

                    <a asp-action="Homepage"
                       class="btn btn-outline-secondary btn-sm">
                        Back to Home
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}